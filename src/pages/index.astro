---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

import WorldTradeCenter from "/public/world_trade_center_guadalajara.jpg";
import CentroBanorte from "/public/centro_de_contacto_banorte.jpg";
import PuntoValle from "/public/punto_valle.jpg";
import Ambar from "/public/ambar.webp";
import Mitt from "/public/mitt.jpg";
import Finsa from "/public/finsa.jpeg";

import Image from "astro/components/Image.astro";

import RecubrimientoEpoxico from "/public/new4.jpeg";
import Impermeabilizante from "/public/impermeabilizacion.jpg";
import Pulido from "/public/new5.jpeg";

import MbsLogo from "/public/mbsLogoTransparent.png";

import MbsVideo from "/public/video.mp4";
---

<Layout>
  <main>
    <section
      class="relative min-h-screen bg-cover bg-center bg-[url(/background.jpg)]"
    >
      <div class="absolute inset-0 bg-gradient-to-br from-black/90 to-black/70">
      </div>

      <div class="relative z-10 flex flex-col min-h-screen">
        <Navbar />

        <div
          class="flex-1 flex mb-20 lg:mb-0 items-center justify-center px-6 sm:px-8 lg:px-20 pt-10 lg:pt-10 pb-10 lg:pb-10"
        >
          <div class="max-w-7xl w-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
              <div class="lg:col-span-1 text-white space-y-6">
                <div class="mb-4">
                  <Image class="w-60 lg:w-96" src={MbsLogo} alt="logo" />
                </div>

                <h2
                  class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight"
                >
                  Soluciones Integrales en
                  <span class="text-red-500">Impermeabilizantes</span>,
                  <span class="text-red-500">Epóxicos</span> y
                  <span class="text-red-500">Uretano</span>
                </h2>

                <p
                  class="text-lg sm:text-xl text-gray-200 leading-relaxed max-w-3xl"
                >
                  Más de 15 años especializados en impermeabilización de todo
                  tipo de superficies, recubrimientos epóxicos, sellos para
                  juntas, pulido y abrillantado de pisos. Líderes en
                  construcción y gerencia de proyectos.
                </p>

                <div class="pt-4 flex flex-wrap gap-4">
                  <a
                    href="#servicios"
                    class="inline-flex items-center px-8 py-4 bg-red-600 text-white font-bold rounded-lg
                           hover:bg-red-800 active:bg-yellow-600 transform hover:scale-105
                           transition-all duration-200 shadow-lg hover:shadow-xl"
                  >
                    NUESTROS SERVICIOS
                    <svg
                      class="ml-2 w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                  <a
                    href="#contacto"
                    class="inline-flex items-center px-8 py-4 border-2 border-red-500 text-white font-bold rounded-lg
                           hover:bg-red-500 hover:text-white transform hover:scale-105
                           transition-all duration-200"
                  >
                    CONTACTO
                  </a>
                </div>
              </div>

              <div class="lg:col-span-1 flex items-center justify-center">
                <div
                  class="bg-white/10 backdrop-blur-md w-full rounded-3xl p-2 border border-white/20"
                >
                  <video
                    class="w-full h-auto max-h-80 object-contain rounded-2xl"
                    controls
                    autoplay
                    muted
                    loop
                    src={MbsVideo}
                  >
                    <source src="" type="video/mp4" />
                  </video>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div
          class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce"
        >
          <div
            class="w-6 h-10 border-2 border-red-600 rounded-full flex justify-center"
          >
            <div class="w-1 h-3 bg-red-500 rounded-full mt-2"></div>
          </div>
        </div>
      </div>
    </section>

    <section id="servicios" class="py-20 bg-gray-900">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-20">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-white mb-4">
            Nuestras Especialidades
          </h2>
          <p class="text-xl text-gray-300 max-w-3xl mx-auto">
            Utilizamos productos y tecnologías más eficientes para cubrir las
            necesidades de la industria, con cobertura en toda la República
            Mexicana
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div
            class="bg-gray-800 p-8 rounded-xl border border-yellow-500/20 hover:border-yellow-500/40 transition-all duration-300 hover:transform hover:scale-105"
          >
            <div class="rounded-lg flex items-center justify-center mb-6">
              <Image src={RecubrimientoEpoxico} alt="recubrimiento epoxico" />
            </div>
            <h3 class="text-xl font-extrabold text-red-600 mb-4">
              Recubrimientos Epóxicos
            </h3>
            <p class="text-gray-300 mb-4">
              Sistemas de alta resistencia para uso industrial
            </p>
            <ul class="text-gray-400 space-y-2">
              <li>• Pisos industriales</li>
              <li>• Estacionamientos</li>
              <li>• Plantas industriales</li>
              <li>• Señalización especializada</li>
            </ul>
          </div>
          <div
            class="bg-gray-800 p-8 rounded-xl border border-yellow-500/20 hover:border-yellow-500/40 transition-all duration-300 hover:transform hover:scale-105"
          >
            <div class="rounded-lg flex items-center justify-center mb-6">
              <Image src={Impermeabilizante} alt="impermeabilizante" />
            </div>
            <h3 class="text-xl font-extrabold text-red-600 mb-4">
              Impermeabilizantes
            </h3>
            <p class="text-gray-300 mb-4">
              Todo tipo de superficies con materiales de alta calidad
            </p>
            <ul class="text-gray-400 space-y-2">
              <li>• Azoteas y terrazas</li>
              <li>• Cisternas y espejos de agua</li>
              <li>• Muros de contención</li>
              <li>• Green Roof y jardines</li>
            </ul>
          </div>
          <div
            class="bg-gray-800 p-8 rounded-xl border border-yellow-500/20 hover:border-yellow-500/40 transition-all duration-300 hover:transform hover:scale-105"
          >
            <div class="rounded-lg flex items-center justify-center mb-6">
              <Image src={Pulido} alt="pulido" />
            </div>
            <h3 class="text-xl font-extrabold text-red-600 mb-4">
              Pulido y Abrillantado
            </h3>
            <p class="text-gray-300 mb-4">
              Tratamiento de pisos de concreto con acabado profesional
            </p>
            <ul class="text-gray-400 space-y-2">
              <li>• Pulido de concreto en planta</li>
              <li>• Abrillantado de pisos</li>
              <li>• Acabados industriales</li>
              <li>• Mantenimiento especializado</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-20">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-900 mb-4">
            Servicios Complementarios
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Somos líderes en Construcción, Gerencia y Administración de
            Proyecto, Ingenierías, Mantenimiento y Limpieza
          </p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
          <div class="bg-white p-8 rounded-xl shadow-lg">
            <h3
              class="text-3xl font-bold text-gray-900 mb-6 border-b-4 border-red-500 pb-2"
            >
              Construcción y Gerencia
            </h3>
            <div class="space-y-4">
              <div class="flex items-start space-x-3">
                <div class="w-2 h-2 bg-red-500 rounded-full mt-2"></div>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    Administración de Proyecto
                  </h4>
                  <p class="text-gray-600">
                    Gerencia integral de proyectos de construcción
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-2 h-2 bg-red-500 rounded-full mt-2"></div>
                <div>
                  <h4 class="font-semibold text-gray-900">Ingenierías</h4>
                  <p class="text-gray-600">
                    Desarrollo de proyectos de ingeniería especializada
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-2 h-2 bg-red-500 rounded-full mt-2"></div>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    Acabados de Construcción
                  </h4>
                  <p class="text-gray-600">
                    Acabados especializados de alta calidad
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white p-8 rounded-xl shadow-lg">
            <h3
              class="text-3xl font-bold text-gray-900 mb-6 border-b-4 border-red-500 pb-2"
            >
              Servicios Adicionales
            </h3>
            <div class="space-y-4">
              <div class="flex items-start space-x-3">
                <div class="w-2 h-2 bg-red-500 rounded-full mt-2"></div>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    Mantenimiento y Limpieza
                  </h4>
                  <p class="text-gray-600">
                    Servicios de mantenimiento preventivo y correctivo
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-2 h-2 bg-red-500 rounded-full mt-2"></div>
                <div>
                  <h4 class="font-semibold text-gray-900">Renta de Máquinas</h4>
                  <p class="text-gray-600">
                    Equipo especializado para construcción
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-2 h-2 bg-red-500 rounded-full mt-2"></div>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    Sellos para Juntas
                  </h4>
                  <p class="text-gray-600">
                    Selladores especializados de uretano
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-gray-900">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-4xl font-bold text-white mb-8">
              ¿Por qué elegir MBS?
            </h2>
            <div class="space-y-6">
              <div class="flex items-start space-x-4">
                <div
                  class="w-8 h-8 bg-red-600 rounded-full flex items-center justify-center flex-shrink-0"
                >
                  <span class="text-black font-bold">✓</span>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-white mb-2">
                    Experiencia Comprobada
                  </h3>
                  <p class="text-gray-300">
                    Más de 15 años especializados en impermeabilización y
                    recubrimientos
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-4">
                <div
                  class="w-8 h-8 bg-red-600 rounded-full flex items-center justify-center flex-shrink-0"
                >
                  <span class="text-black font-bold">✓</span>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-white mb-2">
                    Cobertura Nacional
                  </h3>
                  <p class="text-gray-300">
                    Operaciones en toda la República Mexicana
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-4">
                <div
                  class="w-8 h-8 bg-red-600 rounded-full flex items-center justify-center flex-shrink-0"
                >
                  <span class="text-black font-bold">✓</span>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-white mb-2">
                    Aplicadores Certificados
                  </h3>
                  <p class="text-gray-300">
                    Contamos con el apoyo y reconocimiento de nuestros
                    proveedores
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-4">
                <div
                  class="w-8 h-8 bg-red-600 rounded-full flex items-center justify-center flex-shrink-0"
                >
                  <span class="text-black font-bold">✓</span>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-white mb-2">
                    Proyectos Integrales
                  </h3>
                  <p class="text-gray-300">
                    Industriales, Comerciales y Residenciales
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gray-800 p-8 rounded-xl">
            <h3 class="text-2xl font-extrabold text-white mb-6">
              Nuestros Números
            </h3>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-gray-700 p-4 rounded-lg text-center">
                <div class="text-3xl font-bold text-red-500">42+</div>
                <div class="text-gray-300">Proyectos Activos</div>
              </div>
              <div class="bg-gray-700 p-4 rounded-lg text-center">
                <div class="text-3xl font-bold text-red-500">15+</div>
                <div class="text-gray-300">Años de Experiencia</div>
              </div>
              <div class="bg-gray-700 p-4 rounded-lg text-center">
                <div class="text-3xl font-bold text-red-500">100%</div>
                <div class="text-gray-300">Calidad Garantizada</div>
              </div>
              <div class="bg-gray-700 p-4 rounded-lg text-center">
                <div class="text-3xl font-bold text-red-500">24/7</div>
                <div class="text-gray-300">Atención al Cliente</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-black">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-20">
        <div class="flex justify-between items-center mb-12">
          <div>
            <h2 class="text-4xl font-bold text-white mb-4">
              Algunos de Nuestros Proyectos
            </h2>
            <p class="text-gray-300 max-w-2xl">
              Trabajamos con las empresas más importantes de México en proyectos
              de alta complejidad
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          <div
            class="bg-gray-900 rounded-lg overflow-hidden group hover:transform hover:scale-105 transition-all duration-300"
          >
            <div
              class="h-48 bg-gradient-to-br from-blue-500 to-blue-700 relative"
            >
              <div class="absolute inset-0 bg-black/20">
                <Image src={WorldTradeCenter} alt="world" />
              </div>
              <div class="absolute bottom-4 left-4 text-white">
                <h3 class="text-lg font-bold">World Trade Center</h3>
                <p class="text-sm opacity-90">Guadalajara, Jalisco</p>
              </div>
            </div>
          </div>

          <div
            class="bg-gray-900 rounded-lg overflow-hidden group hover:transform hover:scale-105 transition-all duration-300"
          >
            <div
              class="h-48 bg-gradient-to-br from-teal-500 to-teal-700 relative"
            >
              <div class="absolute inset-0 bg-black/20">
                <Image src={CentroBanorte} alt="world" />
              </div>
              <div class="absolute bottom-4 left-4 text-white">
                <h3 class="text-lg font-bold">Centro de Contacto BANORTE</h3>
                <p class="text-sm opacity-90">San Nicolás de los Garza, N.L.</p>
              </div>
            </div>
          </div>

          <div
            class="bg-gray-900 rounded-lg overflow-hidden group hover:transform hover:scale-105 transition-all duration-300"
          >
            <div
              class="h-48 bg-gradient-to-br from-orange-500 to-orange-700 relative"
            >
              <div class="absolute inset-0 bg-black/20">
                <Image src={PuntoValle} alt="world" />
              </div>
              <div class="absolute bottom-4 left-4 text-white">
                <h3 class="text-lg font-bold">Punto Valle</h3>
                <p class="text-sm opacity-90">
                  Cinépolis, Westin Hotel, Oficinas
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          <div
            class="bg-gray-900 rounded-lg overflow-hidden group hover:transform hover:scale-105 transition-all duration-300"
          >
            <div
              class="h-48 bg-gradient-to-br from-blue-500 to-blue-700 relative"
            >
              <div class="absolute inset-0 bg-black/20">
                <Image src={Mitt} alt="world" />
              </div>
              <div class="absolute bottom-4 left-4 text-white">
                <h3 class="text-lg font-bold">Mitt</h3>
                <p class="text-sm opacity-90">Monterrey, N.L.</p>
              </div>
            </div>
          </div>

          <div
            class="bg-gray-900 rounded-lg overflow-hidden group hover:transform hover:scale-105 transition-all duration-300"
          >
            <div
              class="h-48 bg-gradient-to-br from-teal-500 to-teal-700 relative"
            >
              <div class="absolute inset-0 bg-black/20">
                <Image src={Ambar} alt="world" />
              </div>
              <div class="absolute bottom-4 left-4 text-white">
                <h3 class="text-lg font-bold">Ambar</h3>
                <p class="text-sm opacity-90">Hermosillo, Sonora</p>
              </div>
            </div>
          </div>

          <div
            class="bg-gray-900 rounded-lg overflow-hidden group hover:transform hover:scale-105 transition-all duration-300"
          >
            <div
              class="h-48 bg-gradient-to-br from-orange-500 to-orange-700 relative"
            >
              <div class="absolute inset-0 bg-black/20">
                <Image src={Finsa} alt="world" />
              </div>
              <div class="absolute bottom-4 left-4 text-white">
                <h3 class="text-lg font-bold">FINSA</h3>
                <p class="text-sm opacity-90">
                  Monterrey, N.L.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="contacto" class="py-20 bg-red-700">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-20">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-white mb-4">
            ¿Listo para tu proyecto?
          </h2>
          <p class="text-xl text-gray-200">
            Contáctanos hoy mismo para una cotización gratuita
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-black p-6 rounded-xl text-center">
            <div
              class="w-16 h-16 bg-red-500 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-black"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Teléfonos</h3>
            <p class="text-gray-300">(81) 2039-8790</p>
          </div>
          <div class="bg-black p-6 rounded-xl text-center">
            <div
              class="w-16 h-16 bg-red-500 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-black"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Email</h3>
            <p class="text-gray-300">berthacantu@mbsmexico.com</p>
            <p class="text-gray-300 text-sm">Arq. Bertha Cantu Garza</p>
          </div>
          <div class="bg-black p-6 rounded-xl text-center">
            <div
              class="w-16 h-16 bg-red-500 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-black"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Dirección</h3>
            <p class="text-gray-300">División 21 #150</p>
            <p class="text-gray-300">Col. Antonio I. Villarreal</p>
            <p class="text-gray-300">Monterrey, N.L. C.P. 64390</p>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
