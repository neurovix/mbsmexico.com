---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

import { Image } from "astro:assets";

import Residencial from "/public/casa.png";
import Edificio from "/public/edificio.png";
import Empresa from "/public/empresa.png";
import Escuela from "/public/escuela.png";
import Puente from "/public/puente.png";
import Museo from "/public/museo.png";

import Impermeabilizacion from "/public/impermeabilizacion.jpg";
import Epoxico from "/public/recubrimientos_epoxicos.png";
import Construccion from "/public/construccion.webp";
---

<Layout>
  <main>
    <Navbar />

    <!-- Hero Section -->
    <section
      class="relative bg-gradient-to-br from-blue-50 via-white to-gray-50 pt-15 overflow-hidden"
    >
      {/* Elementos decorativos de fondo */}
      <div class="absolute inset-0 overflow-hidden">
        <div
          class="absolute -top-16 -left-16 w-64 h-64 bg-red-100 rounded-full opacity-20 animate-pulse"
        >
        </div>
        <div
          class="absolute -bottom-16 -right-16 w-80 h-80 bg-red-200 rounded-full opacity-15 animate-pulse delay-1000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/4 w-32 h-32 bg-gradient-to-r from-red-200 to-red-300 rounded-full opacity-10 animate-bounce delay-500"
        >
        </div>
      </div>

      {/* Patrón de puntos decorativo */}
      <div class="absolute inset-0 opacity-5">
        <div class="absolute top-20 left-1/4 w-2 h-2 bg-red-500 rounded-full">
        </div>
        <div class="absolute top-32 right-1/3 w-1 h-1 bg-red-400 rounded-full">
        </div>
        <div
          class="absolute bottom-40 left-1/2 w-1.5 h-1.5 bg-red-600 rounded-full"
        >
        </div>
        <div
          class="absolute bottom-20 right-1/4 w-2 h-2 bg-red-500 rounded-full"
        >
        </div>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          {/* Badge superior */}
          <div
            class="inline-flex items-center px-4 py-2 rounded-full bg-red-100 text-red-800 text-sm font-medium mb-8 animate-fade-in"
          >
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill="evenodd"
                d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clipRule="evenodd"></path>
            </svg>
            Aplicadores certificados con más de 15 años de experiencia
          </div>

          {/* Título principal con animación */}
          <h1
            class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-gray-900 mb-6 leading-tight"
          >
            Nuestros{" "}
            <span class="relative inline-block">
              <span class="text-red-600 relative z-10">Servicios</span>
              <div
                class="absolute bottom-2 left-0 w-full h-3 bg-blue-200 opacity-30 rounded-md transform -skew-x-12"
              >
              </div>
            </span>
          </h1>

          {/* Subtítulo mejorado */}
          <div class="max-w-4xl mx-auto">
            <p class="text-xl md:text-2xl text-gray-600 leading-relaxed mb-8">
              Especialistas en <span class="font-semibold text-red-700"
                >impermeabilizantes</span
              >, <span class="font-semibold text-red-700"
                >epóxico y uretano</span
              >,
              <span class="font-semibold text-red-700">sellos para juntas</span>
              y <span class="font-semibold text-red-700">pulido de pisos</span>
            </p>
            <p class="text-lg text-gray-500 max-w-2xl mx-auto">
              Utilizamos los productos y tecnologías más eficientes para cubrir
              las necesidades de la industria con operaciones en toda la
              República Mexicana.
            </p>
          </div>

          {/* Indicadores de calidad */}
          <div class="flex flex-wrap justify-center gap-6 mt-12">
            <div class="flex items-center space-x-2 text-gray-600">
              <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse">
              </div>
              <span class="text-sm font-medium">Cobertura nacional</span>
            </div>
            <div class="flex items-center space-x-2 text-gray-600">
              <div
                class="w-2 h-2 bg-blue-500 rounded-full animate-pulse delay-200"
              >
              </div>
              <span class="text-sm font-medium">Aplicadores certificados</span>
            </div>
            <div class="flex items-center space-x-2 text-gray-600">
              <div
                class="w-2 h-2 bg-yellow-500 rounded-full animate-pulse delay-400"
              >
              </div>
              <span class="text-sm font-medium">Proyectos integrales</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Servicios Principales -->
    <section class="py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Servicios Especializados
          </h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Soluciones completas en impermeabilización y recubrimientos con
            materiales de la más alta calidad
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Impermeabilización -->
          <div
            class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden group"
          >
            <div
              class="h-48 bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center"
            >
              <Image src={Impermeabilizacion} alt="impermeabilizacion" />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-3">
                Impermeabilización
              </h3>
              <p class="text-gray-600 mb-4">
                Mantenimiento e instalación de impermeabilizantes en todo tipo
                de superficies. Protección garantizada contra filtraciones y
                humedad.
              </p>
              <ul class="space-y-2 text-sm text-gray-600">
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Mantenimiento preventivo
                </li>
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Mantenimiento correctivo
                </li>
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Limpieza especializada
                </li>
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Reparaciones generales
                </li>
              </ul>
            </div>
          </div>

          <!-- Recubrimientos Epóxicos -->
          <div
            class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden group"
          >
            <div
              class="h-32 mb-5 bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center"
            >
              <Image src={Epoxico} alt="epoxico" />
            </div>
            <div class="p-6 pt-16">
              <h3 class="text-xl font-bold text-gray-900 mb-3">
                Recubrimientos Epóxicos
              </h3>
              <p class="text-gray-600 mb-4">
                Aplicación de recubrimientos epóxicos industriales y
                comerciales. Protección duradera para pisos y superficies de
                alto tráfico.
              </p>
              <ul class="space-y-2 text-sm text-gray-600">
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Pintura epóxica industrial
                </li>
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Recubrimientos para estacionamientos
                </li>
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Pulido y abrillantado de concreto
                </li>
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Señalización especializada
                </li>
              </ul>
            </div>
          </div>

          <!-- Mantenimiento y Construcción -->
          <div
            class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden group"
          >
            <div
              class="h-40 mb-5 bg-gradient-to-br from-green-500 to-teal-600 flex items-center justify-center"
            >
              <Image src={Construccion} alt="construccion" />
            </div>
            <div class="p-6 pt-7">
              <h3 class="text-xl font-bold text-gray-900 mb-3">
                Mantenimiento y Construcción
              </h3>
              <p class="text-gray-600 mb-4">
                Servicios integrales de mantenimiento y construcción
                especializada. Soluciones completas para proyectos comerciales e
                industriales.
              </p>
              <ul class="space-y-2 text-sm text-gray-600">
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Construcción de muros de contención
                </li>
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Instalación de green roofs
                </li>
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Reparación de cisternas y tanques
                </li>
                <li class="flex items-center">
                  <svg
                    class="w-4 h-4 text-green-500 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  Mantenimiento de amenidades
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Proyectos Destacados -->
    <section class="py-16 lg:py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Proyectos Destacados
          </h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Algunos de nuestros trabajos más destacados en impermeabilización y
            recubrimientos epóxicos
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-blue-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m0 0H3"
                    ></path>
                  </svg>
                </div>
                <div class="ml-4">
                  <h3 class="text-lg font-bold text-gray-900">
                    World Trade Center Guadalajara
                  </h3>
                  <p class="text-sm text-gray-500">Guadalajara, Jalisco</p>
                </div>
              </div>
              <p class="text-gray-600 text-sm mb-3">
                Impermeabilización de azoteas, cisternas, espejos de agua y
                Green Roof. Pulido y abrillantado de concreto.
              </p>
              <div class="flex items-center text-sm text-green-600">
                <svg
                  class="w-4 h-4 mr-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
                Completado
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-red-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M10.5 3L12 2l1.5 1H21l-1 6H4l-1-6h7.5z"
                    ></path>
                  </svg>
                </div>
                <div class="ml-4">
                  <h3 class="text-lg font-bold text-gray-900">Punto Valle</h3>
                  <p class="text-sm text-gray-500">
                    San Pedro Garza García, NL
                  </p>
                </div>
              </div>
              <p class="text-gray-600 text-sm mb-3">
                Complejo con Cinépolis, Westin Hotel y Oficinas.
                Impermeabilización de áreas generales y pintura epóxica en 6
                sótanos de estacionamiento.
              </p>
              <div class="flex items-center text-sm text-green-600">
                <svg
                  class="w-4 h-4 mr-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
                Completado
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-green-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m0 0H3"
                    ></path>
                  </svg>
                </div>
                <div class="ml-4">
                  <h3 class="text-lg font-bold text-gray-900">Torres EQQUS</h3>
                  <p class="text-sm text-gray-500">
                    San Pedro Garza García, NL
                  </p>
                </div>
              </div>
              <p class="text-gray-600 text-sm mb-3">
                Impermeabilización de muros de contención, Green Roof, azoteas,
                cisternas y recubrimientos epóxicos.
              </p>
              <div class="flex items-center text-sm text-green-600">
                <svg
                  class="w-4 h-4 mr-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
                Completado
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-purple-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"
                    ></path>
                  </svg>
                </div>
                <div class="ml-4">
                  <h3 class="text-lg font-bold text-gray-900">Planetario</h3>
                  <p class="text-sm text-gray-500">
                    San Pedro Garza García, NL
                  </p>
                </div>
              </div>
              <p class="text-gray-600 text-sm mb-3">
                Impermeabilización de azotea y estacionamiento del Planetario,
                proyecto de alta complejidad arquitectónica.
              </p>
              <div class="flex items-center text-sm text-green-600">
                <svg
                  class="w-4 h-4 mr-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
                Completado
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-yellow-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
